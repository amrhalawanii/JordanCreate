{
  "$schema": "product design tokens — aligned with jordan-create-dsv1 native dark theme",
  "source": "Jordan-Create-App-V1/artifacts/jordan-create-dsv1 (native-theme.tsx + tokens.json)",
  "color": {
    "background": {
      "canvas": "#141210",
      "deep": "#0e0d0c",
      "deeper": "#0e0d0c",
      "surface": "#1c1916",
      "raised": "#241f1b"
    },
    "border": {
      "cardBorder": "rgba(245,239,230,0.12)",
      "subtle": "rgba(245,239,230,0.08)",
      "hairline10": "rgba(245,239,230,0.1)",
      "hairline25": "rgba(245,239,230,0.25)"
    },
    "text": {
      "primary": "#f5efe6",
      "offWhite": "#f5efe6",
      "onOrange": "#0f0f0f",
      "muted80": "rgba(245,239,230,0.8)",
      "muted60": "rgba(245,239,230,0.62)",
      "grayLight": "#b4aaa0",
      "grayMuted": "#b4aaa0",
      "grayMid": "#8a8278"
    },
    "brand": {
      "orange": "#ea8f2d",
      "orangeHot": "#ff6b00",
      "orangeRed": "#f3500f",
      "orangeGlow": "rgba(234,143,45,0.3)",
      "gradient": "linear-gradient(111deg, #eebc2b 0%, #faac44 1.1538%, #fe7a1f 100%)",
      "footerGold": "#eeba2b"
    },
    "overlay": {
      "scrim": "rgba(20,18,16,0.62)",
      "glass": "rgba(26,23,20,0.42)"
    }
  },
  "typography": {
    "families": {
      "display": "Georgia, \"Times New Roman\", Times, serif",
      "label": "Inter, system-ui, sans-serif",
      "body": "Inter, system-ui, sans-serif",
      "utility": "Inter, system-ui, sans-serif"
    },
    "note": "Matches mobile nativeTheme.font (Georgia display + Inter UI). Marketing TT Ramillas / DM Sans / Host Grotesk retired for product parity.",
    "scale": {
      "utility": { "fontSize": "11px", "weight": 400, "case": "uppercase" },
      "label": { "fontSize": "13px", "weight": 500 },
      "body": { "fontSize": "16px", "lineHeight": "24px", "weight": 400 },
      "bodyLarge": { "fontSize": "20px", "weight": 400 },
      "displayCompact": { "fontSize": "36px", "weight": 400 },
      "displayMobile": { "fontSize": "48px", "weight": 400 },
      "section": { "fontSize": "44px", "weight": 400 },
      "hero": { "fontSize": "56px", "weight": 400 }
    }
  },
  "breakpoints": {
    "mobile": { "max": "809.98px" },
    "tablet": { "min": "810px", "max": "1199.98px" },
    "desktop": { "min": "1200px" }
  },
  "container": {
    "primary": "1128px",
    "wide": "1184px"
  },
  "spacing": {
    "base": 4,
    "scale": [4, 6, 8, 10, 12, 14, 16, 18, 20, 24, 30, 32, 40, 48, 50, 56, 60, 64, 80]
  },
  "radii": {
    "card": "4px",
    "media": "8px",
    "pill": "20px",
    "pillLarge": "40px"
  },
  "shadow": {
    "note": "Sparse shadows — depth from hairline borders and contrast, matching the mobile app."
  },
  "motion": {
    "smoothScroll": "Lenis (disabled under prefers-reduced-motion)",
    "reveal": "opacity + y:24, 0.5s, once",
    "reducedMotion": "Reveal/Hero/CountUp skip animation; Lenis off"
  }
}
