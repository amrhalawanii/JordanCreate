# Content source (MVP ships on static — no DB reads):
# - static   → embedded TS under src/content/data/ (default; extracted from jordancreate.com)
# - supabase → live speakers + agenda from Supabase; other marketing copy stays static
# - api      → reserved for Express programme API (not implemented)
CONTENT_SOURCE=static

# Required only when CONTENT_SOURCE=supabase (leave unset for MVP launch)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never NEXT_PUBLIC_). Needed until programme-public-read.sql is applied.
# Prefer removing this after running docs/sql/programme-public-read.sql in Supabase SQL editor.
# SUPABASE_SERVICE_ROLE_KEY=

# Base URL for the Jordan Create API server (used when CONTENT_SOURCE=api).
# CONTENT_API_URL=

# Public site URL for canonical / OG metadata overrides in deploy environments.
# NEXT_PUBLIC_SITE_URL=https://www.jordancreate.com
